<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#0A0C0A" android:dashWidth="5dp" android:dashGap="4dp" />
            <corners android:radius="10dp" />
            <gradient android:angle="90" android:endColor="#9C27B0" android:startColor="#F44336"
                android:type="radial"
                android:gradientRadius="100dp"
                android:centerX="1"
                android:centerY="0"/>

        </shape>
    </item>

</selector>